# Токен бота, полученный у @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Способ 1: Прямая интеграция с ЮKassa (по ShopID и SecretKey из личного кабинета ЮKassa):
# Если заполнены эти два параметра, бот создаёт платежные ссылки напрямую через API ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Способ 2: Нативные платежи Telegram (через @BotFather):
# BotFather -> /mybots -> Выбрать бота -> Payments -> ЮKassa -> Connect YooKassa Test/Live
# Если используется Способ 1, этот параметр можно оставить пустым.
PAYMENT_PROVIDER_TOKEN=

# ID администраторов Telegram через запятую (узнать свой ID можно в @userinfobot)
ADMIN_IDS=123456789,987654321

# Ссылка на закрытый канал / чат или материалы (статическая):
CHANNEL_INVITE_LINK=https://t.me/+AbCdEfGhIjK12345

# ID или username закрытого канала для генерации одноразовых ссылок (member_limit=1):
# Если указать и добавить бота администратором в канал, бот будет создавать персональную ссылку каждому ученику.
# CHANNEL_ID=-1001234567890
CHANNEL_ID=

# Username куратора или аккаунта техподдержки в Telegram (отображается в разделе «Помощь»)
# SUPPORT_USERNAME=@katya_support
SUPPORT_USERNAME=

# Путь к файлу базы данных SQLite
DB_NAME=bot_database.db

# Прокси (HTTP или SOCKS5), если провайдер блокирует api.telegram.org:
# Оставьте пустым, если используется VPN на компьютере
# PROXY_URL=socks5://127.0.0.1:10808
# PROXY_URL=http://user:password@ip:port
PROXY_URL=
