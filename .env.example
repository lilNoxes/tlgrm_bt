# Токен бота, полученный у @BotFather
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Токен провайдера платежей ЮKassa, полученный в @BotFather:
# BotFather -> /mybots -> Выбрать бота -> Payments -> ЮKassa (YooKassa) -> Connect YooKassa Test/Live
# Для теста токен обычно имеет вид: 381764678:TEST:XXXXX
PAYMENT_PROVIDER_TOKEN=381764678:TEST:12345

# ID администраторов Telegram через запятую (узнать свой ID можно в @userinfobot)
ADMIN_IDS=123456789,987654321

# Ссылка на закрытый канал / чат или материалы, которая выдается после успешной оплаты
CHANNEL_INVITE_LINK=https://t.me/+AbCdEfGhIjK12345

# Путь к файлу базы данных SQLite
DB_NAME=bot_database.db

# Прокси (HTTP или SOCKS5), если провайдер блокирует api.telegram.org:
# Оставьте пустым, если используется VPN на компьютере
# PROXY_URL=socks5://127.0.0.1:10808
# PROXY_URL=http://user:password@ip:port
PROXY_URL=
